{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "om2": "http://www.ontology-of-units-of-measure.org/resource/om-2/",
      "time": "http://www.w3.org/2006/time#"
    }
  ],
  "@type": "tm:ThingModel",
  "title": "HealthPersonnelTwin",
  "description": "A digital twin representing a healthcare personnel (e.g., nurse or doctor).",
  "tm:optional": [
        "/properties/gender",
        "/properties/status",
        "/properties/location",
        "/properties/genotype",
        "/properties/phoneNumber",
        "/properties/address",
        "/properties/nextOfKin",
        "/properties/shiftStart",
        "/properties/shiftEnd",
        "/properties/onCall"
    ],
  "version": {
    "model": "1.0.0"
  },
  "links": [
    {
      "rel": "tm:submodel",
      "href": "https://raw.githubusercontent.com/Hassanayo/DigitalTwinModels/refs/heads/main/vitals-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "Vitals"
    }
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the health personnel",
      "readOnly": true
    },
    "id": {
      "type": "string",
      "description": "Unique ID assigned to the personnel",
      "readOnly": true
    },
    "role": {
      "type": "string",
      "description": "Personnel role, e.g., Doctor, Nurse, Technician",
      "readOnly": true
    },
    "department": {
      "type": "string",
      "description": "Assigned hospital department or unit",
      "readOnly": true
    },
    "status": {
      "type": "string",
      "description": "Current working status",
      "readOnly": false
    },
    "gender": {
      "type": "string",
      "description": "gender of the patient",
      "readOnly": true
    },
    "location": {
      "type": "string",
      "description": "Current physical or ward location",
      "readOnly": false
    },
    "shiftStart": {
      "type": "string",
      "format": "date-time",
      "description": "Start time of current or next shift",
      "readOnly": false
    },
    "shiftEnd": {
      "type": "string",
      "format": "date-time",
      "description": "End time of current or next shift",
      "readOnly": false
    },
    "onCall": {
      "type": "boolean",
      "description": "Is the personnel currently on call?",
      "readOnly": false
    }
  },
  "actions": {
    "updateStatus": {
      "description": "Update the personnel's status",
      "input": {
        "type": "string"
      }
    },
    "assignToLocation": {
      "description": "Assign the personnel to a new location or ward",
      "input": {
        "type": "string"
      }
    }
  },
  "events": {
    "emergencyCall": {
      "description": "Triggered when the personnel is urgently needed",
      "data": {
        "type": "string"
      }
    }
  }
}
